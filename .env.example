# Bu dosyayı .env olarak kopyalayın: Copy-Item .env.example .env
# Gerçek sır içermez; .env git'e eklenmez.
APP_ENV=development
DATABASE_URL=sqlite:///./data/runtime/app.db
# Demo hesaplarının ortak parolası (yalnızca yerel demo için).
DEMO_USER_PASSWORD=replace_me
# JWT imza anahtarı: zorunlu, en az 32 karakter. Üretmek için:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Yüklenebilecek en büyük belge (MB).
MAX_UPLOAD_MB=10
# Embedding modeli (seçim gerekçesi: docs/adr/05-embedding-model.md). Değişirse tüm belgeler yeniden indekslenir.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
MODEL_CACHE_DIR=data/runtime/models
# Qdrant local mode klasörü ve collection adı. Klasörü aynı anda tek süreç açabilir.
QDRANT_PATH=data/runtime/qdrant
# v2: hibrit arama şeması (dense + BM25). Eski v1 verisini taşımak: uv run python -m scripts.reindex_hybrid
QDRANT_COLLECTION=knowledge_chunks_v2
# Arama: LLM'e en fazla kaç chunk gider ve "kanıt yok" eşiği (model/parçalama değişirse yeniden ölçülür).
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.80
# GPU ile yeniden sıralama (ADR-11). true için önce GPU ortamını kurun: scripts\setup_gpu_env.ps1
# ve API'yi .venv-gpu ile başlatın. CUDA yoksa /chat kurulum hatası (503) döner; sessizce yavaşlamaz.
GPU_ENABLED=false
RERANK_CANDIDATES=20
# Dil modeli: OpenAI uyumlu herhangi bir sağlayıcı. Anahtar yoksa /chat kurulum hatası döner.
# Belge parçaları seçilen sağlayıcıya gönderilir; yalnızca sentetik demo verisi kullanın.
# Örnek (Groq):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=replace_me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
# Örnek modelin bağlam sınırı; model/sağlayıcı değişirse gerçek sınırına göre ayarlayın.
LLM_CONTEXT_WINDOW_TOKENS=131072
# Uygulamanın istem ve geçmiş için kullandığı daha küçük bütçeler.
CHAT_INPUT_BUDGET_TOKENS=8000
CHAT_HISTORY_BUDGET_TOKENS=2500

# --- Herkese açık demo (sunucu) ayarları: docs/deploy-oracle.md ---
# Caddy bu alan adı için HTTPS sertifikasını otomatik alır (ör. knowvia.duckdns.org).
KNOWVIA_DOMAIN=
# Admin'e ayrı, gizli parola; DEMO_USER_PASSWORD ile aynı olamaz. Boşsa admin üye parolasını kullanır.
ADMIN_PASSWORD=
# Giriş ekranında ziyaretçilere gösterilecek üye parolası (DEMO_USER_PASSWORD ile aynı olmalı). Boşsa gösterilmez.
KNOWVIA_PUBLIC_DEMO_PASSWORD=
# Dakikalık istek sınırları (genel sınır LLM kotasını korur).
CHAT_LIMIT_PER_USER_PER_MINUTE=8
CHAT_LIMIT_GLOBAL_PER_MINUTE=20
LOGIN_LIMIT_PER_EMAIL_PER_MINUTE=10
# API açılırken modelleri yükle (ilk ziyaretçi beklemesin). Docker'da compose dosyası açar.
WARMUP_ON_START=false
