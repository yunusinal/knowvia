# Bu dosyayı .env olarak kopyalayın: Copy-Item .env.example .env
# Gerçek sır içermez; .env git'e eklenmez.
APP_ENV=development
DATABASE_URL=sqlite:///./data/runtime/app.db
# Demo hesaplarının ortak parolası (yalnızca yerel demo için).
DEMO_USER_PASSWORD=replace_me
# JWT imza anahtarı: zorunlu, en az 32 karakter. Üretmek için:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Yüklenebilecek en büyük belge (MB).
MAX_UPLOAD_MB=10
