# Caddy: alan adı için Let's Encrypt sertifikasını kendisi alır ve yeniler (otomatik HTTPS).
{$KNOWVIA_DOMAIN} {
	encode zstd gzip
	# /app altında uygulama (Streamlit, baseUrlPath=app); websocket'i reverse_proxy ek ayarsız taşır.
	redir /app /app/
	handle /app/* {
		reverse_proxy app:8501
	}
	# Diğer her şey: statik tanıtım sayfası (docs/index.html + docs/assets).
	handle {
		root * /srv/site
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}
